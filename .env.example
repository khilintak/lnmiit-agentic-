# FocusMate Local - Environment Variables Template
# Copy this file to .env and adjust if necessary.
# Never commit .env with real credentials.

# Local LLM Runtime Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Fallback / Backup Model (e.g., llama3.2:3b, qwen3:1.7b)
OLLAMA_FALLBACK_MODEL=llama3.2:3b

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=False

# Hardware acceleration target (cpu, cuda)
INFERENCE_DEVICE=cuda
